{
  "name": "street-aware",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "predev": "node scripts/prepare-map-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/prepare-map-worker.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:integration": "node --env-file-if-exists=.env --test tests/*.integration.ts",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "db:import": "node --env-file-if-exists=.env scripts/import-crashes.ts"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-style-spec": "26.9.0",
    "lucide-react": "0.468.0",
    "maplibre-gl": "6.19.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "5.9.3"
  }
}
