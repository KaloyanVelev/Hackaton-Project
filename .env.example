# Use a local path, for example C:/Users/you/Downloads/crashes.json on Windows.
CRASH_JSON="./data/crashes.json"

# Optional browser API key from MapTiler Free. Restrict it to your demo origin.
MAPTILER_PUBLIC_KEY=
# Optional override for the white OpenStreetMap Shortbread style.
OSM_STREET_STYLE_URL=
# Optional base URL for a different OSRM driving service.
TRIP_ROUTING_URL=
APP_PORT=3000
